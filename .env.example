# Trawler environment template — copy to .env and fill in.
# .env is gitignored; this file is the documentation.
# Both shell scripts (scripts/*.sh) AND python entry points (trawler CLI,
# pipeline runs, trawler-init) auto-load this file — no `set -a; source .env`
# needed. Already-exported environment variables always win over .env values.
# Override the file location with TRAWLER_ENV_FILE.

# ---------------------------------------------------------------- database
# Postgres control plane (cfg/gen/enc/raw schemas). ROWINFER_DSN also accepted.
TRAWLER_DSN=postgresql://user@localhost:5432/trawler

# ------------------------------------------------- offload remotes (GPU boxes)
# Named remotes: list names in TRAWLER_REMOTES, then per-remote vars
# TRAWLER_REMOTE_<NAME>_SSH / _JOBS / _URL (NAME uppercased).
#   _SSH     ssh target (user@host or an ssh-config alias) — key auth required
#   _JOBS    job-dir root on that box              (default: ~/trawler-jobs)
#   _URL     OpenAI-compatible endpoint ON that box, used by run-bundle there
#            (llama.cpp/LM Studio on loopback — must end /v1)
#   _MODELS  where model weights (GGUF etc.) live / get downloaded on that box
#            (default: ~/models). Point at a shared or restricted dir if the
#            box only allows certain locations.
#   _WORKERS total concurrent requests that box's server takes (default: 4).
#            Used by the FIFO queue (offload.sh enqueue): one job at a time
#            runs at this concurrency; queued jobs auto-start when it finishes.
# First name in TRAWLER_REMOTES is the default.
TRAWLER_REMOTES=studio
TRAWLER_REMOTE_STUDIO_SSH=user@10.0.0.1
TRAWLER_REMOTE_STUDIO_JOBS=~/trawler-jobs
TRAWLER_REMOTE_STUDIO_URL=http://localhost:8080/v1
TRAWLER_REMOTE_STUDIO_MODELS=~/models
TRAWLER_REMOTE_STUDIO_WORKERS=8

# Add more boxes by extending the list:
# TRAWLER_REMOTES=studio,worker2
# TRAWLER_REMOTE_WORKER2_SSH=user@10.0.0.2
# TRAWLER_REMOTE_WORKER2_JOBS=~/trawler-jobs
# TRAWLER_REMOTE_WORKER2_URL=http://localhost:8080/v1

# Two people, SAME already-set-up box (no second box setup needed — only the
# CLIENT-SIDE config below differs): each person's own .env (gitignored,
# never shared) picks its OWN name — anything unique works, it does not need
# to match a username. It's only a local label that gets uppercased into the
# env var prefix and suffixed onto the queue's tmux session
# (trawler-queue-<name>), so two people's queue runners never collide on the
# same box. Only _SSH (the host) is actually shared; _JOBS must differ, and
# _WORKERS should be split so both people's totals stay under the box's real
# capacity. Example — pick any two distinct names, e.g. "studio-1"/"studio-2":
# TRAWLER_REMOTES=studio-1
# TRAWLER_REMOTE_STUDIO_1_SSH=user@10.0.0.1        # same host both people use
# TRAWLER_REMOTE_STUDIO_1_JOBS=~/trawler-jobs-1    # must differ from the other person's
# TRAWLER_REMOTE_STUDIO_1_URL=http://localhost:8080/v1
# TRAWLER_REMOTE_STUDIO_1_WORKERS=4

# ------------------------------------------- model endpoints (direct-mode runs)
# For pipelines that call a model server over the network (no offload), the
# endpoint env var NAME is declared in cfg.model_type (base_url_env) and the
# VALUE lives in your environment. Multiple hosts of the same kind = one
# cfg.model_type row + one env var each, e.g.:
#   trawler.cfg.upsert_model_type('remote_lms_b', 'openai', base_url_env='LMS_B_BASE_URL')
# LMS_REMOTE_BASE_URL=http://10.0.0.1:4160/v1
# LLAMACPP_REMOTE_BASE_URL=http://10.0.0.1:8080/v1
# OLLAMA_REMOTE_BASE_URL=http://10.0.0.1:11434
# ANTHROPIC_API_KEY=sk-ant-...
