{
  "venvPath": ".",
  "venv": ".venv",
  "include": ["."],
  "exclude": [
    "**/.venv",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/*.egg-info",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache"
  ],
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true
}
